# Copie para .env (ignorado pelo git) e preencha. O backstage.sh carrega este arquivo.

# Login com GitHub (opcional). Sem estas variáveis, o login é só como guest.
# Crie um OAuth App em https://github.com/settings/applications/new com:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Token para o catálogo ler o GitHub (opcional: sem ele, usa `gh auth token`)
# GITHUB_TOKEN=
